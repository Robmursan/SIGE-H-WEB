# Includes dependency symlinks used by isolated local worktrees.
**/node_modules
.venv/
.env
.env.*
!.env.example
*.log

# Generated builds, test output and local caches.
dist/
build/
coverage/
.nyc_output/
.cache/
*.tsbuildinfo
__pycache__/
*.py[cod]
