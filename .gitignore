.envrc
.pgpass
.pg_service.conf
.netrc
*.pem
*.key
*.p12
*.pfx
secrets/
backups/
*.dump
*.pgdump
*.backup
*.sql.gz
*.sql.bz2
*.sql.xz
*.sql.zst

