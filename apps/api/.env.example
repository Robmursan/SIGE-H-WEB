NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=55432
DB_USER=sigeh_qa_app
# Default: ~/.config/sigeh/qa-app/password (external directory 0700, file 0600).
# DB_PASSWORD_FILE=/absolute/external/private/password
DB_NAME=sigeh_qa
DB_SCHEMA=sigeh
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_IN_TX_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=15000


SWAGGER_ENABLED=true
# Supply a secure JWT_SECRET externally; this file contains no credential.
JWT_SECRET=
JWT_EXPIRATION=8h

# D1 code only; do not enable until V2/grants and rollout are approved in D2.
IAM_V2_ENABLED=false
# IAM_JWT_ISSUER=https://issuer-authorized.invalid
# IAM_JWT_AUDIENCE=sigeh-api
# IAM_ACCESS_SECONDS=300
# IAM_ARGON_MEMORY_KIB=19456
# IAM_ARGON_PASSES=2

# Prepared reads: requires reviewed SQL grants and explicit IAM facultades first.
L3A_READS_ENABLED=false

# Pase de lista: mantener false hasta autorización de entorno y permisos.
ASISTENCIA_ENABLED=false
